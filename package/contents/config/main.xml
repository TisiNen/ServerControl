<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>

  <group name="General">
    <!-- The whole server list as one JSON string (see code/model.js).
         KConfigXT can't store nested structures. -->
    <entry name="servers" type="String">
      <default>[]</default>
    </entry>

    <!-- The widget's icon in the panel. Empty means the default. -->
    <entry name="icon" type="String">
      <default>network-server-symbolic</default>
    </entry>

    <!-- Seconds between checks, for status functions without their own
         `interval`. -->
    <entry name="defaultInterval" type="Int">
      <default>30</default>
      <min>1</min>
    </entry>

    <!-- Inserted by {ssh}: ssh <sshOptions> user@host. Same default as
         DEFAULT_SSH_OPTIONS in code/commands.js. -->
    <entry name="sshOptions" type="String">
      <default>-o BatchMode=yes -o ConnectTimeout=5</default>
    </entry>

    <!-- Tailscale support. Off: the check never runs, and the settings
         hide everything about Tailscale. -->
    <entry name="tailscaleEnabled" type="Bool">
      <default>false</default>
    </entry>

    <!-- Exit code 0 means Tailscale is active: servers are then reached at
         their tailscaleHost. Only used while tailscaleEnabled is on. -->
    <entry name="tailscaleCommand" type="String">
      <default>tailscale status --json | grep -q '"BackendState": *"Running"'</default>
    </entry>
  </group>
</kcfg>
